# Zetaris local install. An API token from Management > API Tokens uses port 8888;
# otherwise the admin account signs in to the UI proxy on port 3000.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=

# Optional. Hosted Nemotron on build.nvidia.com. Blank means the sentence is skipped, not faked.
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

# Demo pin. Hikma dopamine 40 mg/mL, Unavailable in the FDA shortage file.
STOPGAP_PIN_NDC=0143-9254-25
# Contact string openFDA and NLM ask clients to send.
STOPGAP_USER_AGENT=Stopgap hackathon demo
PORT=8787
