{
  "name": "@stopgap/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "packet": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "zetaris:capture": "tsx --env-file-if-exists=../../.env src/zetaris-capture.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
